<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Правила нужны самому сервису: foreground с systemExempted-типом. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- systemExempted на Android 14+ требует ещё и разрешение на точные
         будильники. USE_EXACT_ALARM выдаётся автоматически (в отличие от
         SCHEDULE_EXACT_ALARM), поэтому startForeground не упадёт с
         SecurityException. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application>
        <service
            android:name="com.strela.onebox.vpn.TunVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>

</manifest>
