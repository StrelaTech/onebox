<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- В профилях и xray-конфиге лежат ключи/пароли — не выгружаем их в облако -->
        <exclude domain="sharedpref" path="profiles.xml" />
        <exclude domain="sharedpref" path="xray.xml" />
        <exclude domain="file" path="logs.log" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="profiles.xml" />
        <exclude domain="sharedpref" path="xray.xml" />
        <exclude domain="file" path="logs.log" />
    </device-transfer>
</data-extraction-rules>
